# ---------------------------------------------------------------------------
# Copy to `.env` (never committed). Every value is optional at build time:
# `next build` and `npm run verify` must pass with this file empty (plan §4.5).
# ---------------------------------------------------------------------------

# --- Database (Hostinger MySQL / Remote MySQL) ------------------------------
# Used lazily, at request time only. Absent => /api/health reports db: "down".
DATABASE_URL="mysql://user:password@host:3306/database"

# --- App ---------------------------------------------------------------------
# Only used when a request carries no usable Host header (background jobs, CLI).
# Per-request origins come from src/sites/registry.ts, never from here.
APP_ORIGIN_FALLBACK="https://paraguayresidency.com"
NODE_ENV="development"
PORT="3000"

# --- Admin session (O2) ------------------------------------------------------
# 32+ characters. Rotating it logs every admin out.
SESSION_SECRET=""

# --- Member session (O9) -----------------------------------------------------
# The member cookie is a DIFFERENT cookie with a DIFFERENT secret from the
# admin one, so a member session can never satisfy requireRole('admin').
# Optional: left empty, it is derived from SESSION_SECRET with a distinct
# purpose, which is already unforgeable from the admin side. Set it (32+ chars)
# when you want the two rotated independently.
MEMBER_SESSION_SECRET=""

# --- Seed (scripts/seed.ts) --------------------------------------------------
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""
SEED_ADMIN_NAME=""
# Set to 1 to reset an existing admin's password on the next seed run.
SEED_FORCE_PASSWORD=""

# --- The Guide entry product, `guide-entry` (plan §1.5) ----------------------
GUIDE_PRICE_CENTS="700"
GUIDE_CURRENCY="USD"
GUIDE_VERSION="1"
# File under `private/` (never `public/`), or set GUIDE_FILE_URL for a bucket.
GUIDE_FILE_KEY="guide-placeholder.pdf"
GUIDE_FILE_URL=""
# Absolute path to the non-public file store. Only needed when it is not
# `<cwd>/private` — e.g. an `output: 'standalone'` release whose server runs
# from `.next/standalone/`, or files kept outside the release directory.
PRIVATE_DIR=""
GUIDE_PRODUCT_NAME="The Paraguay Residency Guide"

# --- The Insider membership, `guide-insider` (O9, plan §1.12) ----------------
# Sold through Lemon Squeezy. Without LEMONSQUEEZY_INSIDER_VARIANT_ID the
# product is seeded INACTIVE and the button says "coming soon" (plan §4.5).
INSIDER_PRICE_CENTS="900"
INSIDER_CURRENCY="USD"
INSIDER_INTERVAL="month"
INSIDER_VERSION="1"
INSIDER_PRODUCT_NAME="Paraguay Residency Insider"

# --- Stripe (O2 test, S6 live) -----------------------------------------------
# Absent => the checkout button renders as "coming soon".
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_GUIDE_PRICE_ID=""

# --- Lemon Squeezy (O9 test, S15 live) ---------------------------------------
# Subscriptions only; Stripe keeps the one-time products (plan §1.13).
# Absent => the Insider checkout answers "coming soon" and nothing breaks.
LEMONSQUEEZY_API_KEY=""
LEMONSQUEEZY_STORE_ID=""
LEMONSQUEEZY_WEBHOOK_SECRET=""
# The Insider variant id, also written to products.provider_price_id by the seed.
LEMONSQUEEZY_INSIDER_VARIANT_ID=""

# --- pararesi import (O9 dry-run, S15 real run) ------------------------------
# Read-only credentials for the pararesi database (plan §5.4.8, §12.3).
PARARESI_DATABASE_URL=""
# How to read pararesi's `purchases.amount_usd`: "cents" or "dollars". Leave
# empty and the import guesses (under 100 = dollars) and warns about every row
# it guessed on — set it explicitly before the real run.
PARARESI_AMOUNT_UNIT=""

# --- VenderCRM (O2) ----------------------------------------------------------
# Absent => leads are stored locally only; crm_status stays "pending".
VENDERCRM_API_URL=""
VENDERCRM_API_KEY=""

# --- Email (O2) --------------------------------------------------------------
# Resend if RESEND_API_KEY, else SMTP if configured, else console.log.
RESEND_API_KEY=""
EMAIL_FROM="Paraguay Residency <hello@paraguayresidency.com>"
EMAIL_NOTIFY_TO=""
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""

# --- Booking (O2, optional) --------------------------------------------------
# Absent => /book renders the consultation form instead of an embed.
NEXT_PUBLIC_BOOKING_URL=""

# --- WhatsApp click-to-chat (S3, approved extra — plan §3b) ------------------
# E.164, digits only (no +). Absent => the click-to-chat link is not rendered.
NEXT_PUBLIC_WHATSAPP_NUMBER=""

# --- Analytics (S6) ----------------------------------------------------------
NEXT_PUBLIC_PLAUSIBLE_ENABLED=""
